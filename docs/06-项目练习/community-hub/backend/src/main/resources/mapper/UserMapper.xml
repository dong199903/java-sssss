<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.community.mapper.UserMapper">
    <select id="selectByUsername" resultType="org.example.community.entity.User">
        SELECT id, username, password_hash, nickname, city_code, role, created_at
        FROM `user`
        WHERE username = #{username}
    </select>
</mapper>
